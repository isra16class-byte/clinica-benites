APP_NAME="Clínica Benites"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guayaquil

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
UNSPLASH_ACCESS_KEY=

# --- Facturación electrónica SRI (MEMORIA.md sección 6) ---
# TODOS pendientes de confirmar/tramitar con el cliente — ver
# docs/FACTURACION_ELECTRONICA_SRI.md. No cargar datos reales hasta tener
# el certificado .p12 y el RUC/establecimiento/punto de emisión asignados
# por el SRI.
CLINICA_RUC=
CLINICA_RAZON_SOCIAL="Clínica Benites"
CLINICA_NOMBRE_COMERCIAL="Clínica Benites"
CLINICA_DIRECCION_MATRIZ=
CLINICA_CONTRIBUYENTE_ESPECIAL=
CLINICA_OBLIGADO_CONTABILIDAD=false
CLINICA_AGENTE_RETENCION=false
CLINICA_ESTABLECIMIENTO_CODE=001
CLINICA_ESTABLECIMIENTO_NAME="Matriz"
CLINICA_PUNTO_EMISION_CODE=001
CLINICA_PUNTO_EMISION_NAME="Caja principal"
# 'pruebas' o 'produccion' — arrancar siempre en 'pruebas'.
SRI_AMBIENTE=pruebas
SRI_CERTIFICATE_PATH=
SRI_CERTIFICATE_PASSWORD=
